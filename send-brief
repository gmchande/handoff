#!/usr/bin/env bash
# send-brief AGENT FILE
#
# Sends FILE's text to the Herdr agent AGENT as one prompt and makes sure the
# agent starts on it. omp sometimes leaves a long paste sitting in its input
# unsent (four times on 26 October); then this presses Enter once, and only
# when omp's input holds the paste. It never sends the text twice.
#
# Exit status:
#   0  sent; the agent was seen working
#   2  usage error
#   5  the agent is gone
#   7  sent, and Enter pressed once if the paste sat unsent, but the agent
#      wasn't seen working: read its pane; never resend by hand
#
# It looks at the agent's name once, then addresses its pane id.
#
# Test hooks: HERDR (the herdr binary), SEND_BRIEF_WAIT (seconds to wait for
# the agent to start, before and after Enter; default 8).

set -u
export LC_ALL=C.UTF-8

HERDR=${HERDR:-herdr}
WAIT=${SEND_BRIEF_WAIT:-8}

die() { # status message
  printf 'send-brief: %s\n' "$2" >&2
  exit "$1"
}

hd() { timeout 60 "$HERDR" "$@"; }

[ $# -eq 2 ] || die 2 "usage: send-brief AGENT FILE"
NAME=$1
FILE=$2
[[ $NAME =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die 2 "AGENT must be a Herdr agent name, not '$NAME'"
[ -s "$FILE" ] || die 2 "no brief at '$FILE'"

json=$(hd agent get "$NAME" 2>/dev/null) || die 5 "no agent named $NAME"
PANE=$(jq -r '.result.agent.pane_id // empty' <<<"$json")
KIND=$(jq -r '.result.agent.agent // empty' <<<"$json")
[ -n "$PANE" ] || die 5 "no agent named $NAME"

# Working, by Herdr's state or, for omp, whose screen Herdr doesn't read, by
# the spinner on its status line.
working() {
  local status
  status=$(hd agent get "$PANE" 2>/dev/null | jq -r '.result.agent.agent_status // empty')
  case $status in working | blocked) return 0 ;; esac
  [ "$KIND" = omp ] && hd agent read "$PANE" --source visible --lines 4 2>/dev/null | grep -q '[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]'
}

started_within() { # seconds
  local i
  for ((i = 0; i < $1; i++)); do
    sleep 1
    working && return 0
  done
  return 1
}

# omp shows a long paste as a chip, "#1", on its editor's bottom line ("╰─").
paste_unsent() {
  hd agent read "$PANE" --source visible --lines 6 2>/dev/null | grep -q -E '^[[:space:]]*╰─[[:space:]]+#[0-9]+[[:space:]]*$'
}

hd agent prompt "$PANE" "$(cat "$FILE")" >/dev/null 2>&1 || die 7 "Herdr refused the prompt for $NAME: read its pane"
started_within "$WAIT" && { echo "send-brief: $NAME started"; exit 0; }

[ "$KIND" = omp ] && paste_unsent || die 7 "$NAME wasn't seen working: read its pane"
hd pane send-keys "$PANE" Enter >/dev/null 2>&1 || die 7 "couldn't press Enter in $NAME's pane: read it"
started_within "$WAIT" && { echo "send-brief: $NAME started after one Enter"; exit 0; }
die 7 "pressed Enter once, but $NAME wasn't seen working: read its pane"
